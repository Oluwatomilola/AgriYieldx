# Hedera Configuration
PRIVATE_KEY=your_private_key_here
HEDERA_NETWORK=https://testnet.hashio.io/api
OPERATOR_ID=0.0.YOUR_ACCOUNT_ID
OPERATOR_KEY=your_operator_private_key_here

# Pinata IPFS Configuration
PINATA_JWT=your_pinata_jwt_token_here

# Server Configuration
PORT=4000

# Token Configuration
# The Hedera Token ID for hUSDT (format: 0.0.XXXXXX)
HUSDT_TOKEN_ID=0.0.YOUR_TOKEN_ID

# Contract Addresses (EVM Format)
# These are the deployed contract addresses on Hedera Testnet
AGRIYIELD_ADDRESS=0xYOUR_AGRIYIELD_CONTRACT_ADDRESS
MARKETPLACE_ADDRESS=0xYOUR_MARKETPLACE_CONTRACT_ADDRESS
MOCK_USDT_ADDRESS=0xYOUR_MOCK_USDT_CONTRACT_ADDRESS
FARM_SHARES_ADDRESS=0xYOUR_FARM_SHARES_CONTRACT_ADDRESS
