# Contract Addresses (EVM Format)
# These should match the deployed contract addresses on Hedera Testnet
VITE_AGRIYIELD_ADDRESS=0xYOUR_AGRIYIELD_CONTRACT_ADDRESS
VITE_MARKETPLACE_ADDRESS=0xYOUR_MARKETPLACE_CONTRACT_ADDRESS
VITE_MOCK_USDT_ADDRESS=0xYOUR_MOCK_USDT_CONTRACT_ADDRESS
VITE_FARM_SHARES_ADDRESS=0xYOUR_FARM_SHARES_CONTRACT_ADDRESS

# IPFS Configuration
# Get these from https://pinata.cloud
VITE_PINATA_JWT=your_pinata_api_key_here
VITE_PINATA_SECRET=your_pinata_secret_here
VITE_PINATA_JWT_SECRET=your_pinata_jwt_secret_here
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud

# WalletConnect Project ID
# Get this from https://cloud.walletconnect.com
VITE_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id_here

# API Configuration
VITE_API_URL=http://localhost:4000/api

# Network Configuration
VITE_CHAIN_ID=296
VITE_RPC_URL=https://testnet.hashio.io/api

# App Configuration (Optional)
VITE_APP_NAME=AgriYield Testnet
